<resources>
    <!-- Same as values-v29, plus the Android 12+ splash: the Sahara logo blooming on a cream circle over Cream. The system hides it at the first frame, so there is no extra wait. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/launcher_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#3B7562</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/launcher_background</item>
        <!-- The logo blooms in (splash_icon_animated.xml, 750 ms); the duration is only read on Android 12L and earlier. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">750</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
